{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "ConnectionStrings": {
    "SqlServer" : "Data Source=(LocalDb)\\MSSQLLocalDB;database=IdentityServer4.Quickstart.EntityFramework-4.0.0;trusted_connection=yes;"
  },

  "AuthProviders": {
    "oidc": {
      "server": "https://<insert-oidc-server>",
      "clientId": "<insert-oidc-clientId>",
      "secret": "<insert-oidc-client-secret>"
    },
    "google": {
      "clientId": "<insert-google-clientId>",
      "secret": "<insert-google-client-secret>"
    }
  },

  "AllowedHosts": "*"
}
