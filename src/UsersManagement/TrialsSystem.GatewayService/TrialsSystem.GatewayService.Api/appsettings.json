{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AuthProviders": {
    "jwt": {
      "issuer": "https://localhost:7140",
      "audience": "https://localhost:7080;http://localhost:5235"
    },
    "oidc": {
      "server": "https://localhost:7140",
      "clientId": "<insert-identity-server-oidc-clientId>",
      "secret": "<insert-identity-server-oidc-client-secret>"
    }
  }
}
